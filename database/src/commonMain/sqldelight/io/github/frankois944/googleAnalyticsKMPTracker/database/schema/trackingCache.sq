CREATE TABLE cache (
    uuid TEXT PRIMARY KEY NOT NULL,
    measurementId TEXT NOT NULL,
    eventDateInMs INTEGER NOT NULL,
    event BLOB NOT NULL
);

CREATE INDEX trackingCache_key ON cache(uuid);

insertUuid:
INSERT OR REPLACE INTO cache (uuid, measurementId, eventDateInMs, event)
VALUES (?, ?, ?,  ?);

deleteUuid:
DELETE FROM cache WHERE uuid = ?;

deleteUuids:
DELETE FROM cache WHERE uuid IN ?;

deleteAll:
DELETE FROM cache;

deleteExpiredEvent:
DELETE FROM cache WHERE eventDateInMs <= ?;

selectUuid:
SELECT * FROM cache WHERE uuid = ? AND measurementId = ?;

selectWithLimit:
SELECT * FROM cache
ORDER BY eventDateInMs ASC
LIMIT ?;

selectUuids:
SELECT * FROM cache WHERE uuid IN ?;

selectAll:
SELECT * FROM cache;

count:
SELECT COUNT(*) FROM cache;

