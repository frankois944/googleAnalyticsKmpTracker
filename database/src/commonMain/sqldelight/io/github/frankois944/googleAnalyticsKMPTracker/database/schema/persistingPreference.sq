CREATE TABLE settings (
  key TEXT PRIMARY KEY NOT NULL,
  scope TEXT NOT NULL,
  value TEXT
);

CREATE INDEX persistingPreference_key ON settings(key);

insertPreference:
INSERT OR REPLACE INTO settings (key, value, scope)
VALUES (?, ?, ?);

deletePreference:
DELETE FROM settings WHERE key = ? AND scope = ?;

selectPreference:
SELECT value FROM settings WHERE key = ? AND scope = ?;

selectAllPreferences:
SELECT * FROM settings WHERE scope = ?;

deleteAllPreferences:
DELETE FROM settings WHERE scope = ?;

deleteAllPreferencesWithScope:
DELETE FROM settings WHERE scope = ?;
